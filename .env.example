# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — ECOSISTEMA DOCKER COMPOSE
# ==============================================================================
# Instrucciones de inicialización:
# 1. Copia este archivo como .env en la raíz del proyecto:
#    cp .env.example .env   (Linux / macOS) o Copy-Item .env.example .env (PowerShell)
# 2. Genera una clave de cifrado APP_KEY válida para Laravel ejecutando:
#    docker run --rm productos-backend:optimized php artisan key:generate --show
#    o bien:
#    php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# 3. Asigna contraseñas seguras a DB_PASSWORD y MYSQL_ROOT_PASSWORD.
# 4. El archivo .env resultante NO debe versionarse en Git.
# ==============================================================================

# --- BASE DE DATOS (Servicio: database - MySQL 8.0) ---
# Nota: MYSQL_* definen la inicialización de MySQL, mientras DB_* son consumidos por Laravel.
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=products_db
MYSQL_USER=products_user
MYSQL_PASSWORD=change_me_db_password

# --- CONFIGURACIÓN DE BASE DE DATOS PARA LARAVEL ---
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=products_db
DB_USERNAME=products_user
DB_PASSWORD=change_me_db_password

# --- BACKEND (Servicio: backend - Laravel 12 / PHP 8.2 / Nginx) ---
APP_NAME="Gestión de Productos API"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Clave de cifrado obligatoria (32 bytes base64)
# REEMPLAZAR con la clave generada en el paso 2
APP_KEY=base64:GENERATE_WITH_ARTISAN_KEY_GENERATE

# Sistema de archivos y almacenamiento de imágenes
FILESYSTEM_DISK=public

# --- FRONTEND (Servicio: frontend - Next.js 16 / App Router) ---
NODE_ENV=production
PORT=3000

# Comunicación interna entre contenedores dentro de la red Docker privada (Docker DNS)
INTERNAL_API_URL=http://backend:8000/api
INTERNAL_STORAGE_URL=http://backend:8000/storage

# Rutas relativas consumidas por los componentes cliente en el navegador
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_STORAGE_URL=/storage
